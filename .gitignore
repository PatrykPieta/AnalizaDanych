# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data files (do not commit raw gigabytes of data to Git!)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.sqlite
*.sqlite3
*.db

# Machine Learning models & binaries
models/*
!models/.gitkeep
*.joblib
*.pkl
*.onnx

# Environment variables & secrets
.env
.env.local
*.env

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
